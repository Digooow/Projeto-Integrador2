# Connection string do Supabase em Settings > Database > Connection string.
# Prefira o modo Session pooler para a API. Nunca versione a senha real.
SUPABASE_CONNECTION_STRING=Host=aws-0-sa-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.PROJECT_REF;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true